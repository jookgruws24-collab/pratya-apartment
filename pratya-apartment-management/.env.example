# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าให้เป็นของจริง (ห้าม commit ไฟล์ .env)
# ใช้ร่วมกับ docker-compose.yml

# ---- ฐานข้อมูล PostgreSQL ----
POSTGRES_DB=apartment_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ---- JWT (ต้องยาวอย่างน้อย 32 ตัวอักษร และเก็บเป็นความลับ) ----
JWT_SECRET=please_change_this_to_a_long_random_secret_key_32chars+
